{
  "manifest_version": 3,
  "name": "Claude Relais",
  "version": "1.0.0",
  "description": "Suit le compte Claude actif de Relais (claude-relais) : échange la session claude.ai à chaque bascule.",
  "key": "",
  "permissions": [
    "cookies",
    "storage",
    "nativeMessaging",
    "tabs",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Relais"
  },
  "minimum_chrome_version": "116"
}
