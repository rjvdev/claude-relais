         "required": ["sujet", "texte"]}},
    {"name": "memoire_corriger", "description": "Remplace une entrée par une nouvelle version (l'ancienne reste dans l'historique).",
     "inputSchema": {"type": "object", "properties": {"id": {"type": "integer"}, "texte": {"type": "string"},
                                                      "raison": {"type": "string"}}, "required": ["id", "texte", "raison"]}},
    {"name": "memoire_demander_suppression", "description": "Demande la suppression d'une entrée ; l'utilisateur accepte ou refuse.",
     "inputSchema": {"type": "object", "properties": {"id": {"type": "integer"}, "raison": {"type": "string"}},
                     "required": ["id", "raison"]}},
]


def outil(nom, a):
    """Renvoie (texte, erreur?)."""
    moi = compte_appelant()
    if nom == "memoire_reprise":
        return reprise(moi) or "Mémoire vide.", False
    if nom == "memoire_journal_ajouter":
        texte = a.get("texte") or ""
        err = controler(texte, maxi=TAILLE_JOURNAL)
        if err:
            return err, True
        ev = ajouter_evenement({"type": "journal", "texte": texte.strip(), "projet": (a.get("projet") or "").strip(), "auteur": auteur()})
        return f"Journal : J{ev['id']} ajouté.", False
    if nom == "memoire_journal":
        jour = (a.get("jour") or "").strip()
        if jour == "liste":
            return "Jours : " + (", ".join(jours_du_journal()) or "aucun"), False
        xs = journal_du(jour or None)
        return ("\n".join(ligne_journal(e) for e in xs) or f"Journal vide pour {jour or 'aujourd’hui'}."), False
    if nom == "memoire_message":
        dest = a.get("a")
        if dest not in cfg.noms() + ["tous"]:
            return f"Destinataire : {', '.join(cfg.noms())} ou tous.", True
        err = controler(a.get("texte") or "", maxi=TAILLE_MESSAGE)
        if err:
            return err, True
        aut = auteur()
        ev = ajouter_evenement({"type": "message", "a": dest, "texte": a["texte"].strip(), "auteur": aut,
                                "de_compte": compte_de_auteur(aut, moi)})
        return f"Message M{ev['id']} laissé pour {dest}.", False
    if nom == "memoire_messages":
        xs = messages(moi, non_lus=not a.get("tous"))
        if not a.get("tous") and xs:
            marquer_lus([e["id"] for e in xs], moi)
        return ("\n".join(ligne_message(e) for e in xs) or "Aucun message."), False
    if nom == "memoire_lire":
        xs = visibles(a.get("sujet"))
        lim = int(a.get("limite") or 200)
        if not xs:
            return "Mémoire vide" + (f" pour le sujet « {a['sujet']} »" if a.get("sujet") else "") + ".", False
        corps = "\n\n".join(fmt(x) for x in xs[:lim])
        return corps + (f"\n\n… {len(xs) - lim} autres entrées (augmenter limite)." if len(xs) > lim else ""), False
    if nom == "memoire_chercher":
        mots = [m.lower() for m in (a.get("texte") or "").split()]
        xs = [x for x in visibles() if all(m in f"{x['sujet']} {x['texte']}".lower() for m in mots)]
        return ("\n\n".join(fmt(x) for x in xs) or "Aucune entrée trouvée."), False
    if nom == "memoire_sujets":
        compte = {}
        for x in visibles():
            compte[x["sujet"] or "divers"] = compte.get(x["sujet"] or "divers", 0) + 1
        return ("\n".join(f"{s} : {n}" for s, n in sorted(compte.items())) or "Aucun sujet."), False
    if nom == "memoire_historique":
        tous = etat()
        i = int(a["id"])
        if i not in tous:
            return f"Entrée #{i} inconnue.", True
        while tous[i].get("remplace") in tous:            # remonter à la première version
            i = tous[i]["remplace"]
        lignes = []
        while i is not None and i in tous:
            x = tous[i]
            lignes.append(f"#{x['id']} ({x['date']}, {x['auteur']}, {x['statut']})" + (f" — raison : {x['raison']}" if x.get("raison") else "")
                          + f"\n{x['texte']}" + (f"\nsuppression demandée : {x['demande']['raison']}" if x.get("demande") else ""))
            i = x.get("remplacee_par")
        return "\n\n".join(lignes), False
    if nom == "memoire_ajouter":
        sujet, texte = (a.get("sujet") or "divers").strip().lower(), a.get("texte") or ""
        err = controler(texte, sujet)
        if err:
            return err, True
        proche = fait_proche(texte)
        if proche:
            r, x = proche
            return (f"refusé : très proche de G{x['id']} ({round(r * 100)} % ; « {x['texte'][:120]} »). "
                    f"Si c'est une mise à jour, utiliser memoire_corriger sur G{x['id']} ; sinon reformuler."), True
        ev = ajouter_evenement({"type": "ajout", "sujet": sujet, "texte": texte.strip(), "auteur": auteur()})
        return f"Ajouté : #{ev['id']} [{sujet}].", False
    if nom == "memoire_corriger":
        tous, i = etat(), int(a["id"])
        if i not in tous or tous[i]["statut"] not in ("active", "suppression_demandee"):
            return f"Entrée #{i} introuvable ou déjà remplacée ou supprimée.", True
        err = controler(a.get("texte") or "", tous[i]["sujet"])
        if err:
            return err, True
        ev = ajouter_evenement({"type": "correction", "remplace": i, "sujet": tous[i]["sujet"], "texte": a["texte"].strip(),
                                "raison": a.get("raison", ""), "auteur": auteur()})
        return f"Corrigé : #{i} → #{ev['id']} (l'ancienne version reste dans l'historique).", False
    if nom == "memoire_demander_suppression":
        tous, i = etat(), int(a["id"])
        if i not in tous or tous[i]["statut"] != "active":
            return f"Entrée #{i} introuvable, déjà remplacée, déjà en attente ou supprimée.", True
        ajouter_evenement({"type": "demande_suppression", "cible": i, "raison": a.get("raison", ""), "auteur": auteur()})
        return f"Demande de suppression de #{i} enregistrée : l'utilisateur la validera.", False
    return f"Outil inconnu : {nom}", True


# ---------- serveur MCP (JSON-RPC sur stdio, un message par ligne) ----------
def serveur():
    def repondre(i, resultat=None, erreur=None):
        msg = {"jsonrpc": "2.0", "id": i}
        msg["error" if erreur else "result"] = erreur or resultat
        sys.stdout.write(json.dumps(msg, ensure_ascii=False) + "\n")
        sys.stdout.flush()

    for ligne in sys.stdin:
        ligne = ligne.strip()
        if not ligne:
            continue
        try:
            m = json.loads(ligne)
        except ValueError:
            repondre(None, erreur={"code": -32700, "message": "JSON invalide"})
            continue
        meth, i, p = m.get("method"), m.get("id"), m.get("params") or {}
        if i is None:                                   # notification : pas de réponse
            continue
        if meth == "initialize":
            repondre(i, {"protocolVersion": p.get("protocolVersion", "2025-06-18"), "capabilities": {"tools": {}},
                         "serverInfo": {"name": "memoire-commune", "version": VERSION}, "instructions": INSTRUCTIONS})
        elif meth == "ping":
            repondre(i, {})
        elif meth == "tools/list":
            repondre(i, {"tools": OUTILS})
        elif meth == "tools/call":
            try:
                texte, err = outil(p.get("name"), p.get("arguments") or {})
            except Exception as e:                      # ne jamais faire tomber le serveur
                texte, err = f"Erreur interne : {e}", True
            repondre(i, {"content": [{"type": "text", "text": texte}], "isError": err})
        else:
            repondre(i, erreur={"code": -32601, "message": f"Méthode inconnue : {meth}"})



# ---------- commandes de l'utilisateur ----------
def demandes():
    return [x for x in etat().values() if x["statut"] == "suppression_demandee"]


def purger(i):
    tous = etat()
    if i not in tous:
        return f"Entrée #{i} inconnue."
    chaine, j = set(), i                                 # toutes les versions liées
    while tous[j].get("remplace") in tous:
        j = tous[j]["remplace"]
    while j is not None and j in tous:
        chaine.add(j)
        j = tous[j].get("remplacee_par")
    with _verrou():
        SAUVEGARDES.mkdir(parents=True, exist_ok=True)
        shutil.copy2(JOURNAL, SAUVEGARDES / f"avant-purge-{time.strftime('%Y-%m-%d-%H%M%S')}.jsonl")
        garde = [e for e in evenements() if e.get("id") not in chaine and e.get("cible") not in chaine]
        tmp = JOURNAL.with_suffix(".tmp")
        tmp.write_text("".join(json.dumps(e, ensure_ascii=False) + "\n" for e in garde), encoding="utf-8")
        tmp.replace(JOURNAL)
    return (f"Purgé : {', '.join('#' + str(k) for k in sorted(chaine))}. Une copie d'avant purge est dans {SAUVEGARDES} : "
            "la supprimer aussi si l'entrée contenait un secret.")


def stats():
    tous = etat().values()
    return {"actives": sum(1 for x in tous if x["statut"] == "active"),
            "non_lus": {c: len(messages(c, non_lus=True)) for c in TRIGRAMMES},
            "demandes": [{"id": x["id"], "sujet": x["sujet"], "texte": x["texte"][:120], "raison": x["demande"]["raison"],
                          "auteur": x["demande"]["auteur"]} for x in tous if x["statut"] == "suppression_demandee"]}


# ---------- extensions locales (hors dépôt) ----------
# Tout fichier ~/.config/claude-relais/memoire_ext_*.py est exécuté dans l'espace de noms de ce script : il peut
# utiliser ses fonctions et ajouter des commandes dans COMMANDES_EXT (nom → fonction(argv) → code de sortie).
COMMANDES_EXT = {}
_AIDE = __doc__
for _ext in sorted((HOME / ".config/claude-relais").glob("memoire_ext_*.py")):
    exec(compile(_ext.read_text(encoding="utf-8"), str(_ext), "exec"), globals())
__doc__ = _AIDE                                         # le docstring d'une extension ne remplace pas l'aide


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "lister"
    if cmd in ("aide", "help", "-h", "--help"):
        print(__doc__)
        return 0
    if cmd == "mcp":
        serveur()
        return 0
    if cmd == "reprise":
        pour = argv[argv.index("--pour") + 1] if "--pour" in argv else compte_appelant()
        print(reprise(pour, seulement_messages="--messages" in argv, marquer="--sans-marquer" not in argv))
        return 0
    if cmd == "journal":
        jour = argv[2] if len(argv) > 2 else None
        print("\n".join(ligne_journal(e) for e in journal_du(jour)) or "Journal vide.")
        return 0
    if cmd == "message" and len(argv) > 3:
        os.environ.setdefault("MEMOIRE_AUTEUR", "UTI")
        ev = ajouter_evenement({"type": "message", "a": argv[2], "texte": " ".join(argv[3:]), "auteur": os.environ["MEMOIRE_AUTEUR"], "de_compte": "utilisateur"})
        print(f"Message M{ev['id']} laissé pour {argv[2]}.")
        return 0
    if cmd in COMMANDES_EXT:
        return COMMANDES_EXT[cmd](argv)
    if cmd == "vues":
        regenerer_vues()
        print(VUES)
        return 0
    if cmd == "lister":
        xs = visibles(argv[2] if len(argv) > 2 else None)
        print("\n\n".join(fmt(x) for x in xs) or "Mémoire vide.")
        return 0
    if cmd == "chercher" and len(argv) > 2:
        print(outil("memoire_chercher", {"texte": " ".join(argv[2:])})[0])
        return 0
    if cmd == "historique" and len(argv) > 2:
        print(outil("memoire_historique", {"id": int(argv[2])})[0])
        return 0
    if cmd == "ajouter" and len(argv) > 3:
        os.environ.setdefault("MEMOIRE_AUTEUR", "UTI")
        texte, err = outil("memoire_ajouter", {"sujet": argv[2], "texte": " ".join(argv[3:])})
        print(texte)
        return 1 if err else 0
    if cmd == "demandes":
        ds = demandes()
        print("\n\n".join(f"{fmt(x)}\n→ demandée par {x['demande']['auteur']} le {x['demande']['date']} : {x['demande']['raison']}"
                          for x in ds) or "Aucune demande en attente.")
        return 0
    if cmd in ("accepter", "refuser") and len(argv) > 2:
        i = int(argv[2])
        if i not in {x["id"] for x in demandes()}:
            print(f"Pas de demande en attente pour #{i}.")
            return 1
        ajouter_evenement({"type": "suppression_acceptee" if cmd == "accepter" else "suppression_refusee", "cible": i,
                           "auteur": "utilisateur"})
        print(f"#{i} : suppression {'acceptée' if cmd == 'accepter' else 'refusée'}.")
        return 0
    if cmd == "purger" and len(argv) > 2:
        print(purger(int(argv[2])))
        return 0
    if cmd == "stats":
        s = stats()
        print(json.dumps(s, ensure_ascii=False) if "--json" in argv else f"{s['actives']} entrées actives, {len(s['demandes'])} demandes de suppression")
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
